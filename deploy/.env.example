# Copy to .env on the VPS. Never commit the real file.
A_CLUSTER_TOKEN=change-me-long-random-hex
# Commander login for the Swarm Console (recommended bootstrap on public VPS):
A_ADMIN_USER=admiral
A_ADMIN_PASSWORD=change-me-too
# Optional instead: leave admin unset and gate the first-run setup screen:
# A_SETUP_TOKEN=one-time-setup-secret
# A_AUTH=off            # emergency/disable login (dev only)
# Relay model for T0 browser nodes:
A_PROVIDER=demo
# A_PROVIDER=deepseek
# A_MODEL=deepseek-chat
# A_API_KEY=...
# Quant host (if the VPS also runs A-Quant jobs):
# A_LLAMA_CPP=/opt/llama.cpp
